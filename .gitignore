# ---------------------------------------------------------------------------
# Root .gitignore - HI & Analysis System
# Subprojects (backend/, config-service/, frontend/) have their own files too.
# ---------------------------------------------------------------------------

# --- Secrets / local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml

# Jupyter
.ipynb_checkpoints/

# --- Node / frontend --------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vite/

# --- Runtime data & generated artefacts -------------------------------------
# SQLite stores (config overrides, HI snapshots) are live local state,
# rebuilt by the app / the 08:00 snapshot job - never source.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# --- OS / editor cruft ------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Claude Code ------------------------------------------------------------
.claude/settings.local.json

# --- Generated report samples -----------------------------------------------
# Rendered PDFs handed over for review; regenerate from the app, do not track.
sample-reports/

# --- Misc temporary ---------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# Tomms slim backups made by db-tools/create_tomms_slim.bat
db-tools/backup/
