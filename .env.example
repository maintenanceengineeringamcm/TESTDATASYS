# Copy to .env and fill in. docker compose reads .env from this folder.
#   cp .env.example .env

# --- Database backups -------------------------------------------------------
# Folder on the Docker host holding the two .bak files:
#   CEB_TRANSMISSION.bak   and   Tomms_CEBT_HI.bak
# Tomms_CEBT_HI.bak is the ~30 MB CMMS copy made by db-tools/create_tomms_slim.bat
# (use it instead of the 66 GB full Tomms_CEBT backup).
# File names do not matter - the database name is read from inside each backup.
BACKUP_DIR=/opt/hi/backups

# --- SQL Server -------------------------------------------------------------
# Administrator password. SQL Server rejects weak ones: at least 8 characters
# with upper case, lower case, a digit and a symbol. Avoid $ (compose treats it
# as a variable).
MSSQL_SA_PASSWORD=Change_Me_Sa#2026

# Edition.
#   Express   - free, licensed for production. Fits with the slim CMMS copy
#               (both databases are a few GB). Uses at most ~1.4 GB of memory
#               for data caching, whatever SQL_MEMORY_MB says.
#   Developer - free, all features, but for development and testing only.
#   Standard / Enterprise - put your licence key here instead:
#               MSSQL_PID=XXXXX-XXXXX-XXXXX-XXXXX-XXXXX
# The full 66 GB Tomms_CEBT needs Developer, Standard or Enterprise.
MSSQL_PID=Express

# Memory SQL Server may use inside its container, in MB. Leave ~2 GB for the rest.
SQL_MEMORY_MB=4096

# Port for connecting SSMS / Azure Data Studio from your PC.
SQL_PORT=1433

# --- Application login (read-only, created by db-init) ----------------------
HI_DB_USER=hi_app
HI_DB_PASSWORD=Change_Me_App#2026

# Database names inside the backups.
HI_DB_NAME=CEB_TRANSMISSION
# Tomms_CEBT_HI = the slim copy (recommended). Set Tomms_CEBT to use the full CMMS backup.
HI_TOMMS_DB_NAME=Tomms_CEBT_HI

# --- Web application --------------------------------------------------------
# Port users open in the browser: http://<server-ip>:5000
APP_PORT=5000
HI_THREADS=8

# Optional secret for POST /api/snapshot/run. Empty = anyone who can open the
# site can start a fleet refresh (a few minutes of database load). Setting it
# blocks the UI's refresh button, which does not send the token; the 08:00
# scheduler is unaffected either way.
HI_SNAPSHOT_TOKEN=

# --- Schedule ---------------------------------------------------------------
TZ=Asia/Colombo
SNAPSHOT_TIME=08:00
